    "Ilgai vairuojant dėmesys krenta. 15 min pertrauka kas 2 valandas – geriausia apsauga nuo nuovargio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention drops on long drives. A 15-minute break every 2 hours is the best protection against fatigue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf langen Fahrten lässt die Konzentration nach. 15 Minuten Pause alle 2 Stunden schützen am besten vor Müdigkeit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy długiej jeździe spada koncentracja. 15 min przerwy co 2 godziny to najlepsza ochrona przed zmęczeniem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En viajes largos baja la atención. 15 minutos de descanso cada 2 horas es la mejor protección contra el cansancio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attention baisse sur les longs trajets. Une pause de 15 min toutes les 2 heures protège le mieux de la fatigue."
          }
        }
      }
    },
