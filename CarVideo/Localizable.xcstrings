    "Automatiškai parenkamas pagal tavo automobilio markę. Stiliai originalūs, tik įkvėpti markių prietaisų skydelių.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picked automatically from your car brand. The styles are original, only inspired by brand dashboards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nach Automarke gewählt. Eigene Designs, nur inspiriert von Hersteller-Cockpits."
