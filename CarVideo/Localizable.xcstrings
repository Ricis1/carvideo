            "state": "translated",
            "value": "Video and map half and half. Drag the divider; the ½ button resets it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video und Karte je zur Hälfte. Trenner ziehbar, ½ setzt zurück."
