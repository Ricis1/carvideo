    "Paspaudus „Turiu“ – daugiau neįspėsime apie šią šalį. Kainos apytikslės, tikrink oficialioje svetainėje.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “I have it” and we won’t warn about this country again. Prices are approximate, check the official site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe „Habe ich“ – dann keine Warnung mehr. Preise ungefähr, offizielle Seite prüfen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Mam“ – nie będziemy już ostrzegać. Ceny orientacyjne, sprawdź oficjalną stronę."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa «La tengo» y no avisaremos más. Precios aproximados, consulta la web oficial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « Je l’ai » : plus d’alerte. Prix indicatifs, vérifiez le site officiel."
          }
        }
      }
    },
