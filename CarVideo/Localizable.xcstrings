    "Atsidaro Google Maps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Google Maps"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Google Maps"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Google Maps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Google Maps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Google Maps"
          }
        }
      }
    },
    "Waze ir Google Maps neleidžia rodyti savo žemėlapio kitose programėlėse, todėl adresas perduodamas jiems ir jie atsidaro. Grįžus atgal, video tęsis nuo ten, kur sustojo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waze and Google Maps don’t allow their maps inside other apps, so the address is handed over and they open. When you come back, the video resumes where it stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Waze und Google Maps erlauben ihre Karten nicht in anderen Apps, daher wird die Adresse übergeben. Zurück in CarVideo läuft das Video weiter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waze i Google Maps nie pozwalają pokazywać swoich map w innych aplikacjach, więc adres jest przekazywany i one się otwierają. Po powrocie wideo wznowi się."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waze y Google Maps no permiten sus mapas en otras apps, así que se les pasa la dirección y se abren. Al volver, el vídeo sigue donde se quedó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Waze et Google Maps n’autorisent pas leurs cartes dans d’autres apps : l’adresse leur est transmise. Au retour, la vidéo reprend."
          }
        }
      }
    },
