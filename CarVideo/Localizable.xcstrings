    "Šalis nustato greičio vienetus, padangų taisykles ir ar leidžiami policijos bei kamerų įspėjimai.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The country sets speed units, tyre rules and whether police and camera alerts are allowed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Land bestimmt Einheiten, Reifenregeln und ob Polizei- und Blitzerwarnungen erlaubt sind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj określa jednostki, zasady opon i czy ostrzeżenia o policji i fotoradarach są dozwolone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El país define unidades, normas de neumáticos y si se permiten avisos de policía y radares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pays définit les unités, les règles de pneus et si les alertes police et radars sont autorisées."
          }
        }
      }
    },
