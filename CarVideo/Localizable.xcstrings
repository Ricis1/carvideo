          "stringUnit": {
            "state": "translated",
            "value": "The speedometer style matches your car. You can change it in settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tacho-Stil passt zu deinem Auto. Änderbar in den Einstellungen."
          }
