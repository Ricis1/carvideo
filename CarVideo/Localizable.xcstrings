    "Pranešimas atsiranda kitų CarVideo vairuotojų žemėlapyje. Jis dingsta po 1 valandos arba kai kiti pažymi, kad jo nebėra.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report appears on other CarVideo drivers’ maps. It disappears after 1 hour or when others mark it gone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Meldung erscheint auf den Karten anderer CarVideo-Fahrer und verschwindet nach 1 Stunde oder wenn andere sie als erledigt markieren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgłoszenie pojawi się na mapach innych kierowców CarVideo. Zniknie po 1 godzinie lub gdy inni oznaczą, że go nie ma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El aviso aparece en los mapas de otros conductores de CarVideo. Desaparece tras 1 hora o si otros marcan que ya no está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signalement apparaît sur la carte des autres conducteurs CarVideo. Il disparaît après 1 heure ou quand d’autres le marquent comme parti."
          }
        }
      }
    },
