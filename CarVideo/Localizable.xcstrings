    "Trumpas garsas, kai telefonas prisijungia prie automobilio ar atsijungia nuo jo. Garsai sukurti mūsų, ne iš kitų programėlių.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short sound when your phone connects to or disconnects from the car. Our own sounds, not taken from other apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzer Ton beim Verbinden oder Trennen vom Auto. Eigene Töne, nicht aus anderen Apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótki dźwięk przy połączeniu lub rozłączeniu z autem. Nasze własne dźwięki."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sonido corto al conectar o desconectar del coche. Sonidos propios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un son bref à la connexion ou déconnexion de la voiture. Nos propres sons."
          }
        }
      }
    },
